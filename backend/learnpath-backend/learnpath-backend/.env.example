# Copy this file to .env for local development.
# On Vercel, set these under Project Settings -> Environment Variables instead.

# --- Oracle DB connection ---
ORACLE_USER=learnpathb
ORACLE_PASSWORD=hackinmotion4665

# Plain connect string, e.g. for a self-hosted / cloud VM Oracle instance:
# host:port/service_name
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1

# --- Oracle Autonomous Database (ATP/ADW) only ---
# If you're using Oracle Autonomous Database, download the wallet zip from
# the OCI console, unzip it into a folder in your project (e.g. ./wallet),
# and set these instead of (or alongside) ORACLE_CONNECT_STRING:
# ORACLE_CONNECT_STRING=your_db_high   (the TNS alias name from tnsnames.ora)
# ORACLE_WALLET_LOCATION=./wallet
# ORACLE_WALLET_PASSWORD=your_wallet_password

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string

# --- Server ---
PORT=3000
